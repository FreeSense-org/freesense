/*
 * Join this firewall to a FreeSense Fleet controller, or leave it.
 *
 *   freesense-join join '<link>' [--key <join key>]   the key is asked for when omitted
 *   freesense-join webjob                             the WebUI guide's join (reads its request file)
 *   freesense-join status
 *   freesense-join leave                              tell the controller, then leave
 *   freesense-join detach                             Emergency Detach: leave without the controller
 *   freesense-join menu                               the console menu entry (interactive)
 *   freesense-join breakglass <hours 1-24> <reason>   suspend policy Lock (alerts at once)
 *   freesense-join breakglass off                     Lock is active again
 *   freesense-join seed                               join from an unattended seed (run at boot)
 *   freesense-join handoff-users [user ...]           users the controller's "Open WebUI" may sign in as (none: off)
 *
 * The join key is secret: prefer the prompt over --key, which stays in the
 * shell history and the process list.
 */

require_once('config.inc');
require_once('functions.inc');
require_once('fleet_agent.inc');
require_once('fleet_guard.inc');
require_once('restapi.inc');

function usage() {
	fwrite(STDERR, "usage: freesense-join join '<link>' [--key <join key>]\n" .
	    "       freesense-join status\n" .
	    "       freesense-join leave\n" .
	    "       freesense-join detach\n" .
	    "       freesense-join menu\n" .
	    "       freesense-join breakglass <hours 1-24> <reason> | off\n" .
	    "       freesense-join handoff-users [user ...]\n");
	exit(64);
}

function ask($prompt, $secret = false) {
	fwrite(STDOUT, $prompt);
	if ($secret) {
		shell_exec('/bin/stty -echo 2>/dev/null');
	}
	$line = fgets(STDIN);
	if ($secret) {
		shell_exec('/bin/stty echo 2>/dev/null');
		fwrite(STDOUT, "\n");
	}
	return ($line === false) ? '' : trim($line);
}

/* The steps as they happen, in plain words. */
function progress($name, $state, $text) {
	static $labels = array('connect' => 'Connecting to the controller', 'verify' => 'Checking the controller\'s certificate',
	    'prove' => 'Proving the join key', 'approval' => 'Waiting for approval', 'tunnel' => 'Setting up the tunnel',
	    'heartbeat' => 'First heartbeat');
	fleet_progress_write($name, $state, $text);
	if ($name === 'fail') {
		fwrite(STDERR, "FAILED  {$text}\n");
	} elseif (($name === 'approval') && ($state === 'wait')) {
		fwrite(STDOUT, "WAITING {$labels[$name]}. Ask the administrator to approve this box and compare the code: {$text}\n");
	} elseif ($state === 'done') {
		fwrite(STDOUT, "OK      {$labels[$name]}\n");
	}
}

/*
 * Join with a link or the controller's invitation text (the key is asked
 * for when neither gives it); Tailscale comes up first when the link or
 * the seed says so ($secret: the PIN of a PIN seed).
 */
function do_join($text, $key, ?array $seed = null, string $secret = '') {
	if (($key === '') && (fleet_join_paste_parse($text)['key'] === null)) {
		$key = ask('Join key: ', true);
	}
	$m = fleet_join($text, $key, $seed, $secret, function ($t) {
		fwrite(STDOUT, "...     {$t}\n");
	}, 'progress');
	fwrite(STDOUT, "\nJoined {$m['controller_url']} as {$m['node_id']} ({$m['role']}).\n");
}

/* The WebUI's guide: the request file holds the link and key; it is deleted before anything else. */
function do_webjob() {
	$req = @json_decode((string)@file_get_contents(FLEET_JOIN_REQUEST_FILE), true);
	@unlink(FLEET_JOIN_REQUEST_FILE);
	if (!is_array($req) || !is_string($req['text'] ?? null)) {
		fleet_progress_write('fail', 'fail', 'E110: The join request was missing.');
		exit(1);
	}
	try {
		fleet_join($req['text'], (string)($req['key'] ?? ''), null, '', function ($t) {
			fleet_progress_write('say', 'start', $t);
		});
		fleet_progress_write('done', 'done', '');
	} catch (FleetJoinError $e) {
		/* fleet_join_run() and fleet_join() wrote the failing step already. */
		$steps = @json_decode((string)@file_get_contents(FLEET_PROGRESS_FILE), true);
		if (!isset($steps['fail'])) {
			fleet_progress_write('fail', 'fail', $e->fleet_code . ': ' . $e->getMessage());
		}
		exit(1);
	}
}

function show_status() {
	$m = fleet_node_membership();
	if (!$m['enrolled']) {
		fwrite(STDOUT, "Not managed by a Fleet controller.\n");
		return false;
	}
	fwrite(STDOUT, "Managed by {$m['controller']['url']}\n  node {$m['node_id']}, role {$m['role']}, connection {$m['method']}, overlay {$m['overlay_address']}\n");
	return true;
}

$args = array_slice($argv, 1);
$command = array_shift($args);

try {
	switch ($command) {
	case 'join':
		$link = array_shift($args);
		if (($link === null) || ($link === '')) {
			usage();
		}
		$key = '';
		if (($args[0] ?? '') === '--key') {
			$key = (string)($args[1] ?? '');
		}
		do_join($link, $key);
		break;
	case 'status':
		exit(show_status() ? 0 : 1);
	case 'leave':
	case 'detach':
		if (!fleet_node_membership()['enrolled']) {
			fwrite(STDERR, "Not managed by a Fleet controller.\n");
			exit(1);
		}
		fleet_leave($command);
		fwrite(STDOUT, "Left the fleet. The last configuration is kept in " . FLEET_ARCHIVE_DIR . ".\n");
		break;
	case 'breakglass':
		if (($args[0] ?? '') === 'off') {
			fleet_breakglass_clear();
			fwrite(STDOUT, "Break-glass ended. Policy Lock is active again.\n");
			break;
		}
		if (!ctype_digit((string)($args[0] ?? '')) || (count($args) < 2)) {
			usage();
		}
		$hours = (int)array_shift($args);
		$rec = fleet_breakglass_set($hours, implode(' ', $args), 'console (' . (getenv('USER') ?: (posix_getpwuid(posix_geteuid())['name'] ?? 'root')) . ')');
		fwrite(STDOUT, 'Break-glass is on until ' . gmdate('Y-m-d H:i', $rec['until']) . " UTC. The controller was alerted.\n");
		break;
	case 'handoff-users':
		/* Local only: which users the controller's "Open WebUI" may sign in as ("" turns it off). */
		require_once('fleet_handoff.inc');
		$users = fleet_handoff_allowed_users(implode(' ', $args));
		foreach ($users as $u) {
			if (restapi_local_user($u) === null) {
				fwrite(STDERR, "No enabled local user {$u}.\n");
				exit(1);
			}
		}
		config_set_path('fleet/handoff_users', implode(' ', $users));
		write_config(empty($users) ? 'Fleet: WebUI handoff turned off.' : 'Fleet: WebUI handoff allowed for ' . implode(', ', $users) . '.');
		fwrite(STDOUT, empty($users) ? "WebUI handoff is off.\n" : 'WebUI handoff allowed for: ' . implode(', ', $users) . "\n");
		break;
	case 'webjob':
		do_webjob();
		break;
	case 'seed':
		/* An unattended seed, started at the end of boot. */
		require_once('fleet_seed.inc');
		$seed = fleet_seed_pending();
		if (($seed === null) || ($seed['mode'] !== 'unattended')) {
			fwrite(STDERR, "No unattended join seed is waiting.\n");
			exit(1);
		}
		do_join($seed['link'], (string)$seed['key'], $seed);
		break;
	case 'menu':
		if (show_status()) {
			if (strtolower(ask('Leave the fleet? (type "leave" to confirm, Enter to go back): ')) === 'leave') {
				fleet_leave('detach');
				fwrite(STDOUT, "Left the fleet.\n");
			}
		} else {
			require_once('fleet_seed.inc');
			$seed = fleet_seed_pending();
			if (($seed !== null) && ($seed['mode'] === 'pin')) {
				fwrite(STDOUT, "A join seed is waiting for its PIN.\n");
				$pin = ask('PIN: ', true);
				$key = fleet_seed_open_key($seed['sealed_key'], $pin);
				if ($key === null) {
					throw new FleetJoinError('E103', 'The PIN is wrong.');
				}
				do_join($seed['link'], $key, $seed, $pin);
			} elseif ($seed !== null) {
				fwrite(STDOUT, "A join seed is waiting for its join key.\n");
				do_join($seed['link'], '', $seed);
			} else {
				$link = ask('Join link or invitation text (https://.../fleet/join#...): ');
				if ($link !== '') {
					do_join($link, '');
				}
			}
		}
		break;
	default:
		usage();
	}
} catch (FleetJoinError $e) {
	fwrite(STDERR, "FLEET-{$e->fleet_code}: {$e->getMessage()}\n");
	exit(1);
} catch (Throwable $e) {
	fwrite(STDERR, 'Failed: ' . $e->getMessage() . "\n");
	exit(1);
}
