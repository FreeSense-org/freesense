/*
 * The system statistics sampler (sysstat.inc): one snapshot a second in
 * /var/run/sysstat.json while someone reads it. Started on demand by
 * sysstat_read(); runs once (a lock on the PID file) and exits on its own
 * after ten minutes without a reader.
 */

require_once('config.inc');
require_once('sysstat.inc');

$fp = @fopen(SYSSTAT_PIDFILE, 'c');
if (($fp === false) || !flock($fp, LOCK_EX | LOCK_NB)) {
	exit(0);
}
ftruncate($fp, 0);
fwrite($fp, (string)getmypid());
fflush($fp);
@chmod(SYSSTAT_PIDFILE, 0644);

sysstat_run();

ftruncate($fp, 0);
flock($fp, LOCK_UN);
fclose($fp);
@unlink(SYSSTAT_PIDFILE);
