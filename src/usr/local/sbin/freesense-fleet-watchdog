/*
 * Usage: freesense-fleet-watchdog <commit-confirm id>
 *
 * Started in the background by a commit-confirm (POST
 * /api/v1/management/commit-confirm). Waits for the deadline and restores
 * the configuration snapshot unless the controller confirmed the change
 * first (FLEET-E310). Exits quietly when the change was confirmed or
 * reverted by someone else.
 */

require_once('config.inc');
require_once('functions.inc');
require_once('fleet_guard.inc');

$id = (string)($argv[1] ?? '');
if (!fleet_confirm_valid_id($id)) {
	fwrite(STDERR, "usage: freesense-fleet-watchdog <commit-confirm id>\n");
	exit(64);
}
exit(fleet_confirm_watch($id));
