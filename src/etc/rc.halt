#!/bin/sh

# /etc/rc.halt

/bin/mkdir -p -m 0700 /var/db/freesense/locks
if ! /usr/bin/lockf -s -k -t 30 /var/db/freesense/locks/config.lock /usr/bin/true; then
	echo "Cannot halt at this moment, a config write operation is in progress and 30 seconds have passed."
	exit 1
fi

sleep 1

/sbin/shutdown -p now
