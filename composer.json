{
    "name": "freesense/freesense",
    "require": {
        "mikehaertl/php-shellcommand": "^1.7",
        "symfony/cache": "^8.1.8",
        "nette/utils": "^4.1.5",
        "simplepie/simplepie": "^1.9",
        "symfony/console": "^8.1.8"
    },
    "autoload": {
        "psr-4": {
            "Netgate\\": "//usr/local/FreeSense/include/Netgate/",
            "FreeSense\\": "//usr/local/FreeSense/include/",
	    "Tools\\Rector\\": "tools/rector/src",
	    "Tools\\Rector\\Tests\\": "tools/rector/tests"
        }
    },
    "config": {
        "vendor-dir": "src/usr/local/FreeSense/include/vendor",
        "optimize-autoloader": true
    },
    "require-dev": {
        "rector/rector": "^2.3.5",
        "nikic/php-parser": "^5.7.0",
        "phpunit/phpunit": "^13.3.6"
    }
}
